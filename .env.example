# ============================================================
# NOVA — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ── General ──────────────────────────────────────────────────
APP_NAME=NOVA
APP_ENV=development
DEBUG=true

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova_secret
POSTGRES_DB=nova_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nova:nova_secret@localhost:5432/nova_db

# ── InfluxDB ─────────────────────────────────────────────────
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=nova-influxdb-admin-token
INFLUXDB_ORG=nova-org
INFLUXDB_BUCKET=nova_metrics
INFLUXDB_USERNAME=nova
INFLUXDB_PASSWORD=nova_secret_123
INFLUXDB_PORT=8086
INFLUXDB_RETENTION=30d

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Google Gemini AI ─────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Telegram Notifications ──────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# ── Polling ──────────────────────────────────────────────────
DEFAULT_POLL_INTERVAL=30

# ── Backend ──────────────────────────────────────────────────
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000/api

# ── Default Admin Account ────────────────────────────────────
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@nova.local
