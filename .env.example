# Application
APP_NAME=NOVA
APP_ENV=production
DEBUG=false
SECRET_KEY=ganti-dengan-random-secret-minimal-32-karakter
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=nova
POSTGRES_PASSWORD=ganti-password-database-kuat
POSTGRES_DB=nova_db
DATABASE_URL=postgresql+asyncpg://nova:ganti-password-database-kuat@postgres:5432/nova_db

# InfluxDB
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=ganti-token-influxdb-production
INFLUXDB_ORG=nova-org
INFLUXDB_BUCKET=nova-metrics
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=ganti-password-influx-kuat

# JWT Auth
JWT_SECRET_KEY=ganti-dengan-jwt-secret-kuat-minimal-32-karakter
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
DEFAULT_ADMIN_PASSWORD=ganti-password-admin-awal

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot Alerting
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Collector & Listeners
DEFAULT_POLL_INTERVAL=30
SYSLOG_UDP_PORT=5140
NETFLOW_UDP_PORT=2055

# Dual-WAN & Infrastructure Profile
WAN_PRIMARY_NAME=ISP JLM
WAN_PRIMARY_DESC=Primary Fiber Dedicated
WAN_PRIMARY_INTERFACE=sfplus1-JLM
WAN_PRIMARY_GATEWAY=119.18.156.153
WAN_SECONDARY_NAME=ISP ION
WAN_SECONDARY_DESC=Secondary Backup Link
WAN_SECONDARY_INTERFACE=ge1-ION
WAN_SECONDARY_GATEWAY=210.79.164.65
WAN_LAN_TRUNK_INTERFACE=sfplus2-SW
WAN_PING_TARGET=8.8.8.8
ACCESS_ROOM_KEYWORDS=kepsek,tu,guru,koperasi,wakil,bph,bussines,lab,kelas

# Frontend & Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
VITE_API_URL=/api
